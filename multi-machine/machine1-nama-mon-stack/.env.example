# =============================================================================
#  MACHINE 1 — nama-mon-stack  —  environment template
#  Copy to .env and fill ONLY non-secret values. NEVER commit .env.
#  Secrets live in ./secrets/ (root-only, git-ignored) — generate with
#  ../ops/gen-secrets.sh; TLS material from ../ops/gen-ca.sh.
#  Images: run ../ops/pin-images.sh to stamp :tag@sha256:<digest>.
#
#  IPs are provider-assigned STATIC addresses — set them and every config
#  (compose binds, scrape targets, CA SAN, UFW) renders from these values.
# =============================================================================

# --- this VM's static IP (provider-assigned) ---
MON_IP=172.29.50.2

# --- Grafana / onetech ---
# Fresh deploy on the provider VMs: no pre-built otech-grafana:13 image exists,
# so use the pinned official base. Provisioning (datasource/dashboards) is
# mounted from ./provisioning, so no custom image layers are required.
# Swap back to the custom image when a Dockerfile/registry ref is available.
ONETECH_IMAGE=grafana/grafana:13.2.2
ONETECH_CONTAINER=onetech
ONETECH_PORT=3000                      # bound to ${MON_IP} in compose
ONETECH_DATA=./onetech-data
ONETECH_MEM_LIMIT=1g

# --- Grafana (non-secret config; PASSWORD via secrets/grafana_admin_password) ---
GF_SECURITY_ADMIN_USER=esmacan
GF_USERS_ALLOW_SIGN_UP=false
GF_PATHS_PROVISIONING=/etc/grafana/provisioning
GF_SERVER_ROOT_URL=https://grafana.example.com   # provisioner stamps <MON_IP>.nip.io
GF_SMTP_HOST=mail-eu.smtp2go.com:2525
GF_SMTP_USER=cockpit-alerts@otech.om   # SMTP PASSWORD via secrets/smtp_password
GF_SMTP_FROM_ADDRESS=cockpit-alerts@otech.om
GF_SMTP_FROM_NAME="NAMA Monitoring"
TZ=Asia/Muscat

# --- Public hostnames (interim: nip.io — no DNS/F5 yet. Swap to F5 VIPs later) ---
# GF_SERVER_ROOT_URL = hostname users type for Grafana (nip.io -> MON_IP:3000).
# KC_PUBLIC_URL      = hostname that fronts Keycloak (nip.io -> AUTH_IP:8443;
#                      must match KC_HOSTNAME on machine3). Realm grafana-namawater.
#   KC_PUBLIC_URL sample: MON_IP=172.29.50.2  AUTH_IP=172.29.50.4
#     GF_SERVER_ROOT_URL=https://grafana.172.29.50.2.nip.io:3000
#     KC_PUBLIC_URL     =https://auth.172.29.50.4.nip.io:8443
KC_PUBLIC_URL=https://auth.example.com  # (override example — provisioner stamps nip.io)
KC_REALM=grafana-namawater

# --- Keycloak OIDC client (realm grafana-namawater; CLIENT SECRET via secrets/) ---
KC_GRAFANA_CLIENT_ID=grafana-nama

# --- VictoriaMetrics ---
VICTORIA_IMAGE=victoriametrics/victoria-metrics:v1.151.0
VICTORIA_CONTAINER=victoria-metrics
VICTORIA_PORT=8428                     # INTERNAL only (vmauth) — no host publish
VICTORIA_STORAGE_PATH=./victoria-metrics-data
VICTORIA_RETENTION=30
VICTORIA_MEM_LIMIT=2g

# --- vmauth ---
VMAUTH_IMAGE=victoriametrics/vmauth:v1.151.0
VMAUTH_MEM_LIMIT=512m
# usernames/passwords for the two service identities are in
# secrets/vmauth_{vmagent,grafana}_{username,password}

# --- Node Exporter ---
NODE_IMAGE=prom/node-exporter:v1.12.1
NODE_CONTAINER=node-exporter
NODE_PORT=9100

# --- host UID/GID for the grafana data mount (official image runs as 472:0) ---
GRAFANA_UID=472
GRAFANA_GID=0