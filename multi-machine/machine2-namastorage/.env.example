# =============================================================================
#  MACHINE 2 — namastorage  —  environment template
#  Copy to .env and fill ONLY non-secret values. NEVER commit .env.
#  Secrets: secrets/vmagent_user, secrets/vmagent_pass, secrets/vmauth_ca.pem
#  (root-only, git-ignored). Generate with ../ops/gen-secrets.sh.
#  Images: run ../ops/pin-images.sh to stamp :tag@sha256:<digest>.
#
#  IPs are provider-assigned STATIC addresses — scrape.yml is rendered from
#  these by deploy.sh (envsubst): set them once and everything lines up.
# =============================================================================

# --- IPs (provider-assigned STATIC) ---
STORAGE_IP=172.29.50.3    # <-- this VM (namastorage)
VMAUTH_IP=172.29.50.2     # <-- VM1 (vmauth / VictoriaMetrics self-scrape)
MON_IP=172.29.50.2        # <-- VM1 node-exporter (same machine, different role)
AUTH_IP=172.29.50.4       # <-- VM3 (Keycloak)

# --- vmagent (secrets: file-based remote-write Basic Auth + TLS CA) ---
VMAGENT_IMAGE=victoriametrics/vmagent:v1.151.0
VMAGENT_CONTAINER=vmagent
VMAGENT_PORT=8429                     # loopback only
VMAGENT_SCRAPE_CONFIG=./scrape.yml
VMAGENT_QUEUE_PATH=./vmagent-queue     # remote-write spill buffer (>= maxDiskUsagePerURL)
VMAGENT_QUEUE_MAX_DISK=10GB
VMAGENT_MEM_LIMIT=2g

# --- Node Exporter ---
NODE_IMAGE=prom/node-exporter:v1.12.1
NODE_CONTAINER=node-exporter
NODE_PORT=9100

# --- Blackbox ---
BLACKBOX_IMAGE=quay.io/prometheus/blackbox-exporter:v0.28.0

# --- Public hostnames probed by blackbox (interim nip.io; swap to F5 VIPs later) ---
#   nip.io resolves to the VM IPs — GF -> MON_IP:3000 (HTTPS), KC -> AUTH_IP:8443
#   (HTTPS). blackbox uses module http_2xx_nipio (skip TLS verify for the
#   internal-CA self-signed leaves) until real public certs arrive.
#   With MON_IP=172.29.50.2 AUTH_IP=172.29.50.4:
GF_PUBLIC_URL=https://grafana.172.29.50.2.nip.io:3000
KC_PUBLIC_URL=https://auth.172.29.50.4.nip.io:8443

# --- Pushgateway (Veeam/batch jobs push to 127.0.0.1:9091) ---
PUSHGW_IMAGE=prom/pushgateway:v1.11.3

# --- FortiGate / OCI exporters (existing deployment; uncomment + fill when added) ---
# FORTIGATE_EXPORTER_IMAGE=
# OCI_EXPORTER_IMAGE=