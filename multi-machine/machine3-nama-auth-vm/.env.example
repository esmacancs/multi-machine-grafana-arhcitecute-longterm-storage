# =============================================================================
#  MACHINE 3 — nama-auth-vm  —  environment template
#  Copy to .env and fill ONLY non-secret values. NEVER commit .env.
#  Secrets: secrets/kc_db_password, secrets/kc_admin_username,
#           secrets/kc_admin_password (root-only, git-ignored).
#  Generate with ../ops/gen-secrets.sh.
#  Images: run ../ops/pin-images.sh to stamp :tag@sha256:<digest>.
# =============================================================================

# --- this VM's static IP (provider-assigned) ---
AUTH_IP=172.29.50.4

# --- Postgres ---
PG_IMAGE=postgres:16

# --- Keycloak (26.7.x; upgrade from 26.0 per design §15) ---
KC_IMAGE=quay.io/keycloak/keycloak:26.7.4

# --- Hostname (interim: nip.io — no F5 yet. KC serves HTTPS itself on 8443) ---
#   With AUTH_IP=172.29.50.4 the public name is auth.172.29.50.4.nip.io
KC_HOSTNAME=auth.example.com
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_STRICT_HTTPS=true
KC_HTTP_ENABLED=true

# --- Interim direct HTTPS (no F5). Leaf certs from ../ops/gen-vm-tls.sh ---
KC_HTTPS_PORT=8443
KC_HTTPS_CERTIFICATE_FILE=/run/secrets/kc_tls.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/run/secrets/kc_tls.key
# KC26 management port (health + vmagent metrics scrape) stays plain HTTP on
# 9000 even though the app interface now serves TLS (KC would otherwise
# inherit HTTPS on the management interface and break the HTTP scrape/health).
KC_HTTP_MANAGEMENT_SCHEME=http

# --- Proxy mode (interim: no F5 — KC terminates TLS itself on 8443.
# passthrough = raw client TLS straight to Keycloak. When F5 arrives,
# terminate TLS there and switch to proxy=edge + xforwarded.) ---
KC_PROXY=passthrough

# --- Node Exporter ---
NODE_IMAGE=prom/node-exporter:v1.12.1

# --- OIDC client served from this Keycloak (client SECRET lives in VM1 secrets) ---
KC_GRAFANA_CLIENT_ID=grafana-nama