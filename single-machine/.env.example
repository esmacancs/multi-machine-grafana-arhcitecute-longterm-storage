# =============================================================================
#  SINGLE MACHINE (all-in-one) stack  —  environment template
#  copy to .env  and  fill in real values.  NEVER commit .env
#
#  Two deployment modes:
#   1) Production:  real domain(s) + Let's Encrypt (acme resolver in traefik.yml)
#   2) Local lab / Windows Docker Desktop:  nip.io hostnames (e.g. grafana.10.0.160.236.nip.io),
#      self-signed TLS (certificatesResolvers {}), realm auto-import from ./kc-import
# =============================================================================

# --- timezone ---
TZ=Asia/Muscat

# --- Grafana (set these to enable local username/password login too; default = Keycloak-only) ---
GF_AUTH_BASIC_ENABLED=false
GF_AUTH_LOGIN_FORM_ENABLED=false
GF_AUTH_DISABLE_LOGIN_FORM=true

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_GrafanaAdmin_1
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# --- Keycloak (admin + db) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_KeycloakAdmin_1
KC_DB_PASSWORD=ChangeMe_KeycloakDb_1

# --- Keycloak hostname (must resolve to this machine) ---
KC_HOSTNAME=identitynama.tech.om

# --- public hostnames routed through Traefik ---
# prod:   DOMAIN_GRAFANA=grafana.tech.om  /  DOMAIN_KEYCLOAK=identitynama.tech.om
# local:  DOMAIN_GRAFANA=grafana.10.0.160.236.nip.io  /  DOMAIN_KEYCLOAK=keycloak.10.0.160.236.nip.io
DOMAIN_GRAFANA=grafana.tech.om
DOMAIN_COCKPIT=cockpitnama.tech.om
DOMAIN_KEYCLOAK=identitynama.tech.om

# --- internal-only hostnames (must NOT be in public DNS) ---
DOMAIN_INTERNAL_VM=vm.tech.om
DOMAIN_INTERNAL_VMAGENT=vmagent.tech.om
DOMAIN_INTERNAL_TRAEFIK=traefik.tech.om

# --- Let's Encrypt ACME (production only) ---
ACME_EMAIL=it@tech.om

# --- VictoriaMetrics retention (days) ---
VICTORIA_RETENTION=30

# --- vmauth basic-auth users ---
VMAGENT_USER=vmagent
VMAGENT_PASS=ChangeMe_VMagent_1
GRAFANA_USER=grafana
GRAFANA_PASS=ChangeMe_GrafanaDatasource_1

# --- Keycloak OIDC clients ---
# grafana-nama = the existing Grafana client in realm "grafana-namawater"
KC_GRAFANA_CLIENT_ID=grafana-nama
KC_GRAFANA_CLIENT_SECRET=ChangeMe_GrafanaClientSecret
# oauth2-proxy = the client used for ForwardAuth on internal dashboards (optional)
KC_OAUTH2_CLIENT_ID=oauth2-proxy
KC_OAUTH2_CLIENT_SECRET=ChangeMe_OAuth2ClientSecret
# generate with:  openssl rand -base64 48
KC_OAUTH2_COOKIE_SECRET=ChangeMe_48ByteBase64CookieSecret

# --- (optional) host UID/GID for grafana container ---
UID=1000
GID=1000

# --- deployment tuning ---
# EDGE_BIND:  empty = bind 80/443 on all interfaces (needed for nip.io LAN hostnames);
#             127.0.0.1 = loopback only
# DOCKER_SOCKET: Linux = /var/run/docker.sock ; Docker Desktop Windows = /var/run/docker.sock (or //var/run/docker.sock)
EDGE_BIND=
DOCKER_SOCKET=/var/run/docker.sock